# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-student' => :debug,
  'Profile-student' => :release,
  'Release-student' => :release,
  'Debug-admin' => :debug,
  'Profile-admin' => :release,
  'Release-admin' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['OTHER_SWIFT_FLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_SWIFT_FLAGS'] << '-enable-experimental-feature'
      config.build_settings['OTHER_SWIFT_FLAGS'] << 'AccessLevelOnImport'

      # Xcode 16 Clang compatibility: suppress incompatible-pointer-types errors in third-party Pods
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['CLANG_WARN_STRICT_PROTOTYPES'] = 'NO'
      config.build_settings['WARNING_CFLAGS'] ||= ['$(inherited)']
      config.build_settings['WARNING_CFLAGS'] << '-Wno-incompatible-pointer-types'
      config.build_settings['WARNING_CFLAGS'] << '-Wno-error=incompatible-pointer-types'
      config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_CFLAGS'] << '-Wno-incompatible-pointer-types'
      config.build_settings['OTHER_CFLAGS'] << '-Wno-error=incompatible-pointer-types'
    end
  end

  # Patch FirebaseCoreInternal for Xcode 15 / Swift 5 compatibility
  lock_file = File.join(installer.sandbox.root, 'FirebaseCoreInternal', 'FirebaseCore', 'Internal', 'Sources', 'Utilities', 'FIRAllocatedUnfairLock.swift')
  if File.exist?(lock_file)
    content = File.read(lock_file)
    if content.include?('sending State')
      File.write(lock_file, content.gsub('sending State', 'State'))
      puts '[Podfile] Successfully patched FIRAllocatedUnfairLock.swift for Swift 5 compiler compatibility.'
    end
  end

  # Patch file_picker for Xcode 16 incompatible pointer types (NSMutableArray vs NSArray)
  pub_cache = ENV['PUB_CACHE'] || File.join(Dir.home, '.pub-cache')
  file_picker_candidates = Dir.glob(File.join(installer.sandbox.root, '**', 'FilePickerPlugin.m')) +
                           Dir.glob(File.join(installer.sandbox.root, '..', '.symlinks', '**', 'FilePickerPlugin.m')) +
                           Dir.glob(File.join(pub_cache, '**', 'file_picker*', '**', 'FilePickerPlugin.m'))
  file_picker_candidates.uniq.each do |file|
    if File.exist?(file)
      content = File.read(file)
      if content.include?('newUrls = urls;')
        File.write(file, content.gsub('newUrls = urls;', 'newUrls = [urls mutableCopy];'))
        puts "[Podfile] Successfully patched #{file} for Xcode 16 compatibility."
      end
    end
  end
end
